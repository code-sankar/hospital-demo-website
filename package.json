{
  "name": "ashvini-hospital",
  "private": true,
  "version": "2.0.0",
  "description": "Full-stack hospital website — React front end, Express API, PostgreSQL (Supabase). Doctor-managed availability, prepaid appointment booking and coded tickets.",
  "type": "module",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server",
    "lint": "npm run lint --workspace client && npm run lint --workspace server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": { "node": ">=20" }
}

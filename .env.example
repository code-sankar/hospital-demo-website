# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Database ---------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → URI.
# Use the "Session"/direct string for a long-running server, the pooled one
# (port 6543) for serverless. Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# TLS is switched on automatically for Supabase hosts; force it here if needed.
# DATABASE_SSL=true
DATABASE_POOL_MAX=10

# --- Sessions ---------------------------------------------------------------
# Generate with:  openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=12

# --- Clinic ---------------------------------------------------------------
# Availability is stored as local wall-clock time in this zone.
CLINIC_TIMEZONE=Asia/Kolkata
# How long a slot is held while the patient pays.
BOOKING_HOLD_MINUTES=10
# Nothing may be booked closer to now than this.
BOOKING_LEAD_MINUTES=60
BOOKING_HORIZON_DAYS=30
CURRENCY=INR

# --- Payments ---------------------------------------------------------------
# "mock" lets you run the whole booking flow locally with no gateway account.
# Switch to "razorpay" for real money. The mock provider refuses to start when
# NODE_ENV=production.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Settings → Webhooks. Subscribe to payment.captured and
# payment.failed, pointing at https://your-api/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------------
# "file" writes each message to server/.mailbox as an .eml you can open.
# "smtp" sends for real.
MAIL_TRANSPORT=file
MAIL_FROM=Ashvini Institute of Medical Sciences <no-reply@ashvini-health.example>
# Every confirmed ticket is copied here. This is the hospital counter's inbox.
COUNTER_INBOX=counter@ashvini-health.example
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
